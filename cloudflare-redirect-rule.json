{
  "description": "leoknox.me: canonical HTTPS apex host",
  "expression": "(http.host eq \"www.leoknox.me\") or (http.host eq \"leoknox.me\" and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://leoknox.me\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
